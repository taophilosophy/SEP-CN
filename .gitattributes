# 行尾统一 LF（ADR 级约定：库内与工作区一律 LF，禁止 CRLF 入库）
# 全局侧配套：git config --global core.autocrlf false && core.eol lf
* text=auto eol=lf

# 二进制资产不做行尾/文本过滤
*.png binary
*.jpg binary
*.gif binary
*.ico binary

*.md linguist-vendored=false
*.md linguist-generated=false
*.md linguist-documentation=false
*.md linguist-detectable=true
