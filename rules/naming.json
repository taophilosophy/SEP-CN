{
 "schema": "sep-naming/v1",
 "status": "accepted",
 "date": "2026-11-25",
 "revision": "2026-11-25 首版：三层分离（identifier／name／state），22 节点分配 ex／tr／rv／sg 号段（ADR-0080）",
 "note": "本文件是节点标识的唯一事实源：identifier 永不变、永不复用；name 可演进（带 name_version）；state 由 identifier 派生。判据、顺序、对象域仍以 rules/pipeline.json 为准，本文件不复制。历史 journal 与 tasks.steps 不改写，经 aliases 解析。",
 "authority": [
  "ISO/IEC 11179-5:2015 命名与标识原则（标识与名称分离、唯一、稳定、不复用）",
  "GB/T 18391.5-2009（等同采用 11179-5:2005）",
  "ISO 15489-1:2016 记录不可篡改",
  "ISO/IEC/IEEE 12207:2017 配置标识唯一且稳定"
 ],
 "layers": {
  "identifier": "段缩写＋两位序号；永不变、永不复用；已退役号不回收",
  "name": "段.阶段，全小写 kebab；可演进，改名须升 name_version 并保留旧名至 aliases",
  "label": "中文展示名，可翻译、可润色，不承载标识",
  "state": "identifier＋_checked；状态是 journal 的派生视图（ADR-0068），不承载名称语义"
 },
 "patterns": {
  "identifier": "^(ex|tr|rv|sg)-(0[1-9]|1[0-9])$",
  "name": "^(extract|translate|review|signoff)\\.[a-z][a-z0-9-]*$",
  "state": "^(ex|tr|rv|sg)-(0[1-9]|1[0-9])_checked$"
 },
