    },
    "service": {
      "standard": "GB/T 19682-2005",
      "limit": "1.5‰",
      "use": "服务基线，不作出版门"
    }
  },
  "sampling": {
    "machine": "all",
    "manual": {
      "strata": "H2",
      "min_per_stratum": 1,
      "min_ratio": 0.1,
      "min_segments": 20,
      "order": "sha256(slug+segment)",
      "critical_escalation": "full"
    }
  },
  "scorecard_evidence": "results/qa/<slug>-<date>.json"
